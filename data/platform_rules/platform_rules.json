    },
    {
      "platform": "Google Merchant Center",
      "content_type": "product_listing",
      "rule_id": "GMC-H-007",
      "rule_type": "platform_hard_rule",
      "description": "描述必须准确且与落地页相符，只包含商品信息；不得包含店铺链接、销售信息、竞品、其他商品或配件信息。",
      "limit": {
        "field": "description",
        "must_match_landing_page": true,
        "prohibited_content": [
          "store_links",
          "sales_information",
          "competitor_details",
          "other_products",
          "unrelated_accessories"
        ]
      },
      "severity": "block",
      "source_id": "GMC-PDS",
      "source_url": "https://support.google.com/merchants/answer/7052112?hl=en",
      "verified_date": "2026-07-28"
    },
    {
      "platform": "Google Merchant Center",
      "content_type": "product_listing",
      "rule_id": "GMC-H-008",
      "rule_type": "platform_hard_rule",
      "description": "必须提供以 http 或 https 开头、属于已验证域名且可访问的商品落地页链接。",
      "limit": {
        "field": "link",
        "required": true,
        "allowed_schemes": [
          "http",
          "https"
        ],
        "verified_domain_required": true
      },
      "severity": "block",
      "source_id": "GMC-PDS",
      "source_url": "https://support.google.com/merchants/answer/7052112?hl=en",
      "verified_date": "2026-07-28"
    },
    {
      "platform": "Google Merchant Center",
      "content_type": "product_listing",
      "rule_id": "GMC-H-009",
      "rule_type": "platform_hard_rule",
      "description": "必须提供可抓取且准确展示商品的主图链接；主图不得含促销文字、水印、边框、占位图或通用图。",
      "limit": {
        "field": "image_link",
        "required": true,
        "prohibited_content": [
          "promotional_text",
          "watermark",
          "border",
          "placeholder",
          "generic_image"
        ]
      },
      "severity": "block",
      "source_id": "GMC-PDS",
      "source_url": "https://support.google.com/merchants/answer/7052112?hl=en",
      "verified_date": "2026-07-28"
    },
    {
      "platform": "Google Merchant Center",
      "content_type": "product_listing",
      "rule_id": "GMC-H-010",
      "rule_type": "platform_hard_rule",
      "description": "生成式 AI 创建的商品图片必须保留标识数字来源的 IPTC 元数据。",
      "limit": {
        "field": "image_metadata.IPTC.DigitalSourceType",
        "required_when": "image_is_generative_ai",
        "accepted_examples": [
          "TrainedAlgorithmicMedia",
          "CompositeSynthetic",
          "AlgorithmicMedia"
        ]
      },
      "severity": "block",
      "source_id": "GMC-PDS",
      "source_url": "https://support.google.com/merchants/answer/7052112?hl=en",
      "verified_date": "2026-07-28"
    },
    {
      "platform": "Google Merchant Center",
      "content_type": "product_listing",
      "rule_id": "GMC-H-011",
      "rule_type": "platform_hard_rule",
      "description": "必须提交受支持的库存状态，并与落地页、结账页及结构化数据一致。",
      "limit": {
        "field": "availability",
        "required": true,
        "allowed_values": [
          "in_stock",
          "out_of_stock",
          "preorder",
          "backorder"
        ],
        "must_match_landing_and_checkout": true
      },
      "severity": "block",
      "source_id": "GMC-PDS",
      "source_url": "https://support.google.com/merchants/answer/7052112?hl=en",
      "verified_date": "2026-07-28"
    },
    {
      "platform": "Google Merchant Center",
      "content_type": "product_listing",
      "rule_id": "GMC-H-012",
      "rule_type": "platform_hard_rule",
      "description": "必须以 ISO 4217 货币代码提交准确价格，并与落地页、结构化数据和结账页一致。",
      "limit": {
        "field": "price",
        "required": true,
        "currency_standard": "ISO_4217",
        "must_match_landing_and_checkout": true
      },
      "severity": "block",
      "source_id": "GMC-PDS",
      "source_url": "https://support.google.com/merchants/answer/7052112?hl=en",
      "verified_date": "2026-07-28"
    },
    {
      "platform": "Google Merchant Center",
      "content_type": "product_listing",
      "rule_id": "GMC-H-013",
      "rule_type": "platform_hard_rule",
      "description": "不得使用虚假、无法支持或把极不可能结果包装为预期结果的宣称，也不得虚构关联或背书。",
      "limit": {
        "field": "all_content",
        "prohibited_content": [
          "false_claims",
          "improbable_results_as_expected",
          "false_affiliation",
          "false_endorsement",
          "harmful_health_claims"
        ]
      },
      "severity": "block",
      "source_id": "GMC-MISREP",
      "source_url": "https://support.google.com/merchants/answer/6150127?hl=en",
      "verified_date": "2026-07-28"
    },
    {
      "platform": "Google Merchant Center",
      "content_type": "product_listing",
      "rule_id": "GMC-H-014",
      "rule_type": "platform_hard_rule",
      "description": "落地页必须清楚披露完整费用、付款条件、条款、配送及退换退款政策，且商品实际可购买。",
      "limit": {
        "field": "landing_page",
        "required_information": [
          "total_price_and_currency",
          "payment_conditions",
          "terms_and_conditions",
          "shipping_information",
          "return_and_refund_policy"
        ]
      },
      "severity": "block",
      "source_id": "GMC-MISREP",
      "source_url": "https://support.google.com/merchants/answer/6150127?hl=en",
      "verified_date": "2026-07-28"
    },
    {
      "platform": "Google Merchant Center",
      "content_type": "product_listing",
      "rule_id": "GMC-H-015",
      "rule_type": "platform_hard_rule",
      "description": "商品内容和网站须使用规范拼写与语法，避免异常标点、符号、大小写、空格和重复。",
      "limit": {
        "field": "all_content",
        "prohibited_patterns": [
          "spelling_errors",
          "grammar_errors",
          "gimmicky_punctuation",
          "excessive_capitalization",
          "abnormal_spacing",
          "keyword_repetition"
        ]
      },
      "severity": "block",
      "source_id": "GMC-EDITORIAL",
      "source_url": "https://support.google.com/merchants/answer/6150244?hl=en",
      "verified_date": "2026-07-28"
    },
    {
      "platform": "Google Merchant Center",
      "content_type": "product_listing",
      "rule_id": "GMC-B-001",
      "rule_type": "platform_best_practice",
      "description": "标题按“品牌/商品类型—关键可验证特征—规格或变体”的顺序组织，并把最重要信息放前面。",
      "limit": {
        "field": "title",
        "recommended_structure": [
          "brand_or_product_type",
          "verified_key_feature",
          "size_or_variant"
        ]
      },
      "severity": "info",
      "source_id": "GMC-PDS",
      "source_url": "https://support.google.com/merchants/answer/7052112?hl=en",
      "verified_date": "2026-07-28"
    },
    {
      "platform": "Google Merchant Center",
      "content_type": "product_listing",
      "rule_id": "INT-LST-001",
      "rule_type": "project_internal_rule",
      "description": "项目 Listing 输出固定包含 1 个标题、5 个卖点和 1 个描述；五点卖点是内部结构，不冒充 Google 必填字段。",
      "limit": {
        "field": "content",
        "required_sections": {
          "title": 1,
          "bullet_points": 5,
          "description": 1
        }
      },
      "severity": "block",
      "source_id": "PROJECT-BRIEF",
      "source_url": "project_brief.md",
      "verified_date": "2026-07-28"
    },
    {
      "platform": "Google Merchant Center",
      "content_type": "product_listing",
      "rule_id": "INT-LST-002",
      "rule_type": "project_internal_rule",
      "description": "每个关键商品陈述至少绑定一个 fact_id；信息不足时不得补写。",
      "limit": {
        "field": "claims[].fact_ids",
        "min_items": 1,
        "fallback": "insufficient_information"
      },
      "severity": "block",
      "source_id": "PROJECT-BRIEF",
      "source_url": "project_brief.md",
      "verified_date": "2026-07-28"
    },
    {
