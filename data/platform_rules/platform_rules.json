    },
    {
      "platform": "Google Merchant Center",
      "content_type": "product_listing",
      "rule_id": "GMC-H-006",
      "rule_type": "platform_hard_rule",
      "description": "使用生成式 AI 创建描述时必须使用 structured_description，并将 digital_source_type 设为 trained_algorithmic_media。",
      "limit": {
        "field": "structured_description.digital_source_type",
        "required_when": "description_is_generative_ai",
        "allowed_values": [
          "trained_algorithmic_media"
        ]
      },
      "severity": "block",
      "source_id": "GMC-AI-2024",
      "source_url": "https://support.google.com/merchants/answer/14784710?hl=en",
