  "rules": [
    {
      "platform": "Google Merchant Center",
      "content_type": "product_listing",
      "rule_id": "GMC-H-001",
      "rule_type": "platform_hard_rule",
      "description": "每个商品必须提交唯一且稳定的 id。",
      "limit": {
        "field": "id",
        "required": true,
        "max": 50,
        "unit": "characters"
      },
      "severity": "block",
      "source_id": "GMC-PDS",
      "source_url": "https://support.google.com/merchants/answer/7052112?hl=en",
      "verified_date": "2026-07-28"
    },
    {
      "platform": "Google Merchant Center",
      "content_type": "product_listing",
      "rule_id": "GMC-H-002",
      "rule_type": "platform_hard_rule",
      "description": "必须提交 title 或 structured_title；标题不得超过 150 个字符。",
      "limit": {
        "field": "title_or_structured_title",
        "required": true,
        "max": 150,
        "unit": "characters"
      },
      "severity": "block",
      "source_id": "GMC-PDS",
      "source_url": "https://support.google.com/merchants/answer/7052112?hl=en",
      "verified_date": "2026-07-28"
    },
    {
      "platform": "Google Merchant Center",
      "content_type": "product_listing",
      "rule_id": "GMC-H-003",
      "rule_type": "platform_hard_rule",
      "description": "使用生成式 AI 创建标题时必须使用 structured_title，并将 digital_source_type 设为 trained_algorithmic_media。",
      "limit": {
        "field": "structured_title.digital_source_type",
        "required_when": "title_is_generative_ai",
        "allowed_values": [
          "trained_algorithmic_media"
        ]
      },
      "severity": "block",
      "source_id": "GMC-AI-2024",
      "source_url": "https://support.google.com/merchants/answer/14784710?hl=en",
      "verified_date": "2026-07-28"
    },
    {
      "platform": "Google Merchant Center",
      "content_type": "product_listing",
      "rule_id": "GMC-H-004",
      "rule_type": "platform_hard_rule",
      "description": "标题必须准确描述商品并与落地页标题相匹配；不得加入免邮等促销文本、全大写或花哨字符。",
      "limit": {
        "field": "title",
        "must_match_landing_page": true,
        "prohibited_patterns": [
          "promotional_text",
          "all_caps",
          "gimmicky_characters"
        ]
      },
      "severity": "block",
      "source_id": "GMC-PDS",
      "source_url": "https://support.google.com/merchants/answer/7052112?hl=en",
      "verified_date": "2026-07-28"
    },
    {
      "platform": "Google Merchant Center",
      "content_type": "product_listing",
      "rule_id": "GMC-H-005",
      "rule_type": "platform_hard_rule",
      "description": "必须提交 description 或 structured_description；描述不得超过 5000 个字符。",
      "limit": {
        "field": "description_or_structured_description",
        "required": true,
        "max": 5000,
        "unit": "characters"
      },
      "severity": "block",
      "source_id": "GMC-PDS",
      "source_url": "https://support.google.com/merchants/answer/7052112?hl=en",
