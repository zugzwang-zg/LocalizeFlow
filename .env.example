# Copy this file to .env and fill in local values. Never commit .env.
# The Closed Beta model path stays disabled unless explicitly enabled.
LOCALIZEFLOW_BETA_MODEL_ENABLED=false
LOCALIZEFLOW_MODEL_BASE_URL=
LOCALIZEFLOW_MODEL_API_KEY=
LOCALIZEFLOW_MODEL_NAME=
# openai_chat_completions or anthropic_messages
LOCALIZEFLOW_MODEL_API_STYLE=openai_chat_completions
LOCALIZEFLOW_MODEL_TIMEOUT_SECONDS=45
LOCALIZEFLOW_MODEL_MAX_RETRIES=1
LOCALIZEFLOW_MODEL_MAX_OUTPUT_TOKENS=3000
LOCALIZEFLOW_MODEL_INPUT_USD_PER_MILLION=0
LOCALIZEFLOW_MODEL_OUTPUT_USD_PER_MILLION=0
LOCALIZEFLOW_MODEL_MAX_REQUEST_COST_USD=0.10
LOCALIZEFLOW_MODEL_SUPPORTS_JSON_SCHEMA=false

