# Copy this file to .env and fill in local values. Never commit .env.
# The Closed Beta model path stays disabled unless explicitly enabled.
LOCALIZEFLOW_BETA_MODEL_ENABLED=false
LOCALIZEFLOW_MODEL_BASE_URL=
LOCALIZEFLOW_MODEL_API_KEY=
LOCALIZEFLOW_MODEL_NAME=
# openai_chat_completions or anthropic_messages
LOCALIZEFLOW_MODEL_API_STYLE=openai_chat_completions
LOCALIZEFLOW_MODEL_TIMEOUT_SECONDS=45
LOCALIZEFLOW_MODEL_MAX_RETRIES=1
LOCALIZEFLOW_MODEL_MAX_OUTPUT_TOKENS=3000
LOCALIZEFLOW_MODEL_INPUT_USD_PER_MILLION=0
LOCALIZEFLOW_MODEL_OUTPUT_USD_PER_MILLION=0
LOCALIZEFLOW_MODEL_MAX_REQUEST_COST_USD=0.10
LOCALIZEFLOW_MODEL_SUPPORTS_JSON_SCHEMA=false

# Local safety limits for any model-backed trial. Disabled by default.
# A hosted deployment still needs durable atomic storage plus trusted account/IP identity.
LOCALIZEFLOW_TRIAL_LIMITS_ENABLED=false
LOCALIZEFLOW_TRIAL_FUNDING_MODE=owner_funded_capped
# Required when limits are enabled; generate a unique 32+ character deployment secret.
LOCALIZEFLOW_TRIAL_IDENTIFIER_HMAC_SECRET=
LOCALIZEFLOW_TRIAL_ACCOUNT_MONTHLY_GENERATIONS=3
LOCALIZEFLOW_TRIAL_PROJECT_MONTHLY_GENERATIONS=3
LOCALIZEFLOW_TRIAL_PROJECT_MAX_LANGUAGES=2
LOCALIZEFLOW_TRIAL_RATE_WINDOW_SECONDS=600
LOCALIZEFLOW_TRIAL_ACCOUNT_RATE_LIMIT=3
LOCALIZEFLOW_TRIAL_PROJECT_RATE_LIMIT=3
LOCALIZEFLOW_TRIAL_CLIENT_RATE_LIMIT=5
LOCALIZEFLOW_TRIAL_ACCOUNT_DAILY_COST_USD=0.10
LOCALIZEFLOW_TRIAL_GLOBAL_DAILY_COST_USD=1.00
LOCALIZEFLOW_TRIAL_GLOBAL_MONTHLY_COST_USD=10.00
LOCALIZEFLOW_TRIAL_REJECTIONS_BEFORE_ALERT=3

# Local encrypted tenant store. Disabled by default; not a hosted identity provider.
LOCALIZEFLOW_TENANT_STORE_ENABLED=false
LOCALIZEFLOW_TENANT_DATABASE_PATH=.private/localizeflow_tenants.sqlite3
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LOCALIZEFLOW_TENANT_MASTER_KEY=
LOCALIZEFLOW_TENANT_SESSION_TTL_MINUTES=30

# Local D4 operational telemetry and emergency controls. All remain closed by default.
# The monitor is process-local; it is not production monitoring or an external alert channel.
LOCALIZEFLOW_OPS_MONITORING_ENABLED=false
LOCALIZEFLOW_OPS_MODEL_CALLS_ENABLED=false
LOCALIZEFLOW_OPS_EXPORTS_ENABLED=false
# May use the trial identifier secret locally; production should use a separately managed secret.
LOCALIZEFLOW_OPS_IDENTIFIER_HMAC_SECRET=
LOCALIZEFLOW_OPS_RETENTION_HOURS=168
LOCALIZEFLOW_OPS_MAX_EVENTS=5000
LOCALIZEFLOW_OPS_WINDOW_MINUTES=15
LOCALIZEFLOW_OPS_MIN_SAMPLES=5
LOCALIZEFLOW_OPS_AVAILABILITY_WARNING=0.99
LOCALIZEFLOW_OPS_AVAILABILITY_CRITICAL=0.95
LOCALIZEFLOW_OPS_REQUEST_SUCCESS_WARNING=0.95
LOCALIZEFLOW_OPS_REQUEST_SUCCESS_CRITICAL=0.80
LOCALIZEFLOW_OPS_PAGE_ERROR_WARNING=0.05
LOCALIZEFLOW_OPS_PAGE_ERROR_CRITICAL=0.15
LOCALIZEFLOW_OPS_SCHEMA_SUCCESS_WARNING=0.98
LOCALIZEFLOW_OPS_SCHEMA_SUCCESS_CRITICAL=0.90
LOCALIZEFLOW_OPS_RETRY_RATE_WARNING=0.10
LOCALIZEFLOW_OPS_RETRY_RATE_CRITICAL=0.25
LOCALIZEFLOW_OPS_GENERATION_P95_WARNING_MS=30000
LOCALIZEFLOW_OPS_GENERATION_P95_CRITICAL_MS=60000
LOCALIZEFLOW_OPS_EXPORT_SUCCESS_WARNING=0.95
LOCALIZEFLOW_OPS_EXPORT_SUCCESS_CRITICAL=0.80

