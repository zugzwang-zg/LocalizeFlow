{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zugzwang-zg/LocalizeFlow/schemas/beta_sku_import.schema.json",
  "title": "LocalizeFlow Closed Beta SKU fact import",
  "type": "object",
  "required": ["schema_version", "facts"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "facts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sku", "attribute", "value", "evidence_level", "source", "source_type", "market_scope", "generation_policy"],
        "properties": {
          "sku": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
          "attribute": {"enum": ["product_name", "specification", "ingredient", "usage_instruction", "packaging_container", "packaging_material", "packaging_capacity", "allowed_claim", "prohibited_claim"]},
          "value": {"type": ["string", "number"], "minLength": 1},
          "unit": {"type": ["string", "null"], "maxLength": 32},
          "evidence_level": {"enum": ["A", "B", "C", "U"]},
          "source": {"type": "string", "minLength": 2, "maxLength": 500},
          "source_type": {"enum": ["primary_spec", "label", "testing_report", "brand_policy", "legal_review", "participant_statement", "unknown"]},
          "market_scope": {"type": "string", "pattern": "^(US|MX|US;MX|MX;US)$"},
          "allowed_expression": {"type": ["string", "null"], "maxLength": 1000},
          "prohibited_expression": {"type": ["string", "null"], "maxLength": 1000},
          "generation_policy": {"enum": ["direct", "cautious", "blocked", "not_directly_usable"]}
        }
      }
    }
  }
}
